# Supabase PostgreSQL (Server-side only — never expose service role key publicly)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (Optional — API falls back to database directly when omitted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security Secrets
ADMIN_API_SECRET=
CRON_SECRET=

# Source Website Configuration
SOURCE_BASE_URL=https://tv1.nontondrama.vip
MOVIE_SOURCE_BASE_URL=https://tv13.lk21official.cc
SEARCH_API_BASE_URL=https://gudangvape.com
THUMBNAIL_BASE_URL=https://poster.assetsy.de/wp-content/uploads/

# Scraper Rate Limiting & Crawl Controls
SCRAPER_DELAY_MS=500
SCRAPER_CONCURRENCY=2
SCRAPER_TIMEOUT_MS=15000
SCRAPER_MAX_RETRIES=3
SCRAPER_MAX_PAGES_PER_RUN=10
SCRAPER_DETAIL_BATCH_SIZE=20
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; NontonDramaMetadataBot/1.0)

# API & Runtime Settings
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=info
