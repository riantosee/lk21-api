{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/v1/**/*.js": {
      "maxDuration": 30
    },
    "api/v1/cron/*.js": {
      "maxDuration": 60
    },
    "api/v1/admin/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/quick-sync",
      "schedule": "*/45 * * * *"
    },
    {
      "path": "/api/v1/cron/detail-sync",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/v1/cron/episode-sync",
      "schedule": "30 */4 * * *"
    }
  ]
}
